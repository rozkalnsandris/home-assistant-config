    "convenience_permits_rdc": false,
    "order": [
      "GITHUB_CONNECTED_TOOLS",
      "GITHUB_HOSTED_CI_WHEN_APPLICABLE",
      "MINIMAL_AUTHORIZED_RDC_IF_GITHUB_INCAPABLE",
      "STOP"
    ]
  },
  "rdc_exception": {
    "actual_host_local_need_required": true,
    "github_capability_gap_required": true,
    "github_ci_not_equivalent_required": true,
    "minimal_authorized_operation_only": true,
    "existing_owner_authority_required": true,
    "public_safe_evidence_record_required": true,
    "return_to_github_required": true,
    "evidence_fields": [
      "STEP",
      "REPOSITORY_AND_TARGET",
      "GITHUB_CAPABILITY_CHECKED",
      "PRECISE_CAPABILITY_GAP",
      "GITHUB_CI_NOT_EQUIVALENT_REASON",
      "MINIMAL_RDC_OPERATION",
      "EXISTING_AUTHORIZATION",
      "GITHUB_RETURN_EVIDENCE"
    ]
  },
  "stop_guards": {
    "github_denied_stops": true,
    "github_403_429_rate_limit_stops": true,
    "github_tool_error_timeout_stops": true,
    "uncertain_github_write_stops": true,
    "no_duplicate_host_git_mutation": true,
    "no_implicit_retry_rollback_cleanup": true
  },
  "local_boundaries": {
    "public_source_privacy_rules_unchanged": true,
    "source_of_truth_boundaries_unchanged": true,
    "fast_lane_v22_default_unchanged": true,
    "auto_run_full_explicit_only": true,
    "github_only_explicit_only": true,
    "live_all_explicit_only": true,
    "controller_140_unchanged": true,
    "merge_requires_owner_authorization": true,
    "merge_does_not_authorize_live": true,
    "home_assistant_live_requires_separate_exact_authorization": true,
    "private_state_never_public": true,
    "secrets_permissions_settings_no_new_authority": true,
    "host_actions_and_device_actuation_no_new_authority": true
  },
